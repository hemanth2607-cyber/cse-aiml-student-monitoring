{
  "name": "cse-aiml-student-monitoring-backend",
  "version": "1.0.0",
  "description": "Backend for CSE(AIML) Student Monitoring System",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:local": "prisma db push --schema=prisma/schema.sqlite.prisma && node scripts/seed.js",
    "db:supabase": "prisma db push --schema=prisma/schema.prisma && node scripts/seed.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "student",
    "monitoring",
    "aiml",
    "leetcode",
    "hackathon",
    "internship",
    "supabase",
    "prisma",
    "groq"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^1.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.9",
    "passport": "^0.7.0",
